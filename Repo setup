    'jroc-ai-pro-bono/frontend/src/app/cases/new/page.tsx': '"use client";\n\nimport { useState } from "react";\nimport { useRouter } from "next/navigation";\nimport Link from "next/link";\nimport { Scale, Loader2 } from "lucide-react";\nimport { createCase } from "@/lib/api";\n\nconst CATEGORIES = [\n  "Housing / Tenant Rights",\n  "Employment / Wage Theft",\n  "Family Law / Custody",\n  "Immigration",\n  "Criminal Defense",\n  "Civil Rights / Discrimination",\n  "Consumer Protection",\n  "Benefits / Public Assistance",\n  "Other",\n];\n\nexport default function NewCasePage() {\n  const router = useRouter();\n  const [form, setForm] = useState({\n    title: "",\n    description: "",\n    category: "",\n    urgency: 3,\n  });\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState("");\n\n  function update(field: string, value: string | number) {\n    setForm((prev) => ({ ...prev, [field]: value }));\n  }\n\n  async function handleSubmit(e: React.FormEvent) {\n    e.preventDefault();\n    if (!form.category) { setError("Please select a category."); return; }\n    setError("");\n    setLoading(true);\n    try {\n      const newCase = await createCase(form);\n      router.push(`/cases/${newCase.id}`);\n    } catch (err: any) {\n      setError(err.message || "Failed to create case.");\n    } finally {\n      setLoading(false);\n    }\n  }\n\n  return (\n    <div className="min-h-screen bg-gray-50">\n      <header className="bg-white border-b">\n        <div className="max-w-2xl mx-auto px-4 h-16 flex items-center justify-between">\n          <div className="flex items-center gap-2 font-bold text-brand-700">\n            <Scale className="h-5 w-5" /> Open a New Case\n          </div>\n          <Link href="/cases" className="text-sm text-muted-foreground hover:text-foreground">â† Back to Cases</Link>\n        </div>\n      </header>\n\n      <main className="max-w-2xl mx-auto px-4 py-8">\n        <div className="bg-white rounded-2xl border border-gray-100 shadow-sm p-8">\n          {error && (\n            <div className="mb-4 p-3 bg-destructive/10 text-destructive text-sm rounded-lg">{error}</div>\n          )}\n\n          <form onSubmit={handleSubmit} className="space-y-5">\n            <div>\n              <label className="block text-sm font-medium text-gray-700 mb-1.5">Case Title *</label>\n              <input\n                type="text"\n                value={form.title}\n                onChange={(e) => update("title", e.target.value)}\n                required\n                maxLength={200}\n                placeholder="e.g., Landlord withholding security deposit"\n                className="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"\n              />\n            </div>\n\n            <div>\n              <label className="block text-sm font-medium text-gray-700 mb-1.5">Category *</label>\n              <select\n                value={form.category}\n                onChange={(e) => update("category", e.target.value)}\n                className="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"\n              >\n                <option value="">Select a categoryâ€¦</option>\n                {CATEGORIES.map((c) => (\n                  <option key={c} value={c}>{c}</option>\n                ))}\n              </select>\n            </div>\n\n            <div>\n              <label className="block text-sm font-medium text-gray-700 mb-1.5">Describe your situation *</label>\n              <textarea\n                value={form.description}\n                onChange={(e) => update("description", e.target.value)}\n                required\n                rows={5}\n                maxLength={2000}\n                placeholder="Describe what happened, key dates, parties involved, and what outcome you\'re seekingâ€¦"\n                className="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 resize-none"\n              />\n              <div className="text-xs text-muted-foreground text-right mt-1">{form.description.length}/2000</div>\n            </div>\n\n            <div>\n              <label className="block text-sm font-medium text-gray-700 mb-2">Urgency Level</label>\n              <div className="flex gap-2">\n                {[1, 2, 3, 4, 5].map((level) => (\n                  <button\n                    key={level}\n                    type="button"\n                    onClick={() => update("urgency", level)}\n                    className={`flex-1 py-2 text-sm rounded-lg border transition-colors ${\n                      form.urgency === level\n                        ? "bg-brand-600 text-white border-brand-600"\n                        : "border-gray-200 text-gray-600 hover:border-brand-300"\n                    }`}\n                  >\n                    {level}\n                  </button>\n                ))}\n              </div>\n              <div className="flex justify-between text-xs text-muted-foreground mt-1">\n                <span>Low</span><span>Critical</span>\n              </div>\n            </div>\n\n            <button\n              type="submit"\n              disabled={loading}\n              className="w-full bg-brand-600 text-white py-3 rounded-lg text-sm font-medium hover:bg-brand-700 transition-colors disabled:opacity-60 flex items-center justify-center gap-2"\n            >\n              {loading && <Loader2 className="h-4 w-4 animate-spin" />}\n              {loading ? "Opening caseâ€¦" : "Open Case"}\n            </button>\n          </form>\n        </div>\n      </main>\n    </div>\n  );\n}\n',
    'jroc-ai-pro-bono/frontend/src/app/dashboard/page.tsx': '"use client";\n\nimport { useEffect, useState } from "react";\nimport Link from "next/link";\nimport { useRouter } from "next/navigation";\nimport {\n  MessageSquare, FolderOpen, FileText, Upload,\n  AlertTriangle, Plus, TrendingUp, Scale\n} from "lucide-react";\nimport { getCases, getDocuments } from "@/lib/api";\nimport type { Case, Document } from "@/types";\n\nconst STATUS_COLORS: Record<string, string> = {\n  open: "bg-blue-100 text-blue-700",\n  in_progress: "bg-yellow-100 text-yellow-700",\n  escalated: "bg-red-100 text-red-700",\n  closed: "bg-gray-100 text-gray-600",\n};\n\nexport default function DashboardPage() {\n  const router = useRouter();\n  const [cases, setCases] = useState<Case[]>([]);\n  const [documents, setDocuments] = useState<Document[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    const token = localStorage.getItem("jroc_token");\n    if (!token) { router.push("/login"); return; }\n\n    Promise.all([getCases(), getDocuments()])\n      .then(([c, d]) => { setCases(c); setDocuments(d.documents); })\n      .catch(() => router.push("/login"))\n      .finally(() => setLoading(false));\n  }, [router]);\n\n  const stats = [\n    { label: "Open Cases", value: cases.filter(c => c.status === "open").length, icon: FolderOpen, color: "text-blue-600", bg: "bg-blue-50" },\n    { label: "In Progress", value: cases.filter(c => c.status === "in_progress").length, icon: TrendingUp, color: "text-yellow-600", bg: "bg-yellow-50" },\n    { label: "Escalated", value: cases.filter(c => c.status === "escalated").length, icon: AlertTriangle, color: "text-red-600", bg: "bg-red-50" },\n    { label: "Documents", value: documents.filter(d => d.status === "ready").length, icon: FileText, color: "text-green-600", bg: "bg-green-50" },\n  ];\n\n  if (loading) return (\n    <div className="min-h-screen flex items-center justify-center">\n      <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-brand-600" />\n    </div>\n  );\n\n  return (\n    <div className="min-h-screen bg-gray-50">\n      {/* Header */}\n      <header className="bg-white border-b">\n        <div className="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">\n          <div className="flex items-center gap-2 font-bold text-brand-700">\n            <Scale className="h-5 w-5" /> JROC Pro Bono\n          </div>\n          <nav className="flex items-center gap-6">\n            <Link href="/chat" className="text-sm text-muted-foreground hover:text-foreground flex items-center gap-1.5">\n              <MessageSquare className="h-4 w-4" /> Chat\n            </Link>\n            <Link href="/cases" className="text-sm text-muted-foreground hover:text-foreground flex items-center gap-1.5">\n              <FolderOpen className="h-4 w-4" /> Cases\n            </Link>\n            <Link href="/documents" className="text-sm text-muted-foreground hover:text-foreground flex items-center gap-1.5">\n              <Upload className="h-4 w-4" /> Documents\n            </Link>\n            <button\n              onClick={() => { localStorage.removeItem("jroc_token"); router.push("/login"); }}\n              className="text-sm text-muted-foreground hover:text-destructive"\n            >\n              Sign Out\n            </button>\n          </nav>\n        </div>\n      </header>\n\n      <main className="max-w-6xl mx-auto px-4 py-8">\n        <div className="mb-8">\n          <h1 className="text-2xl font-bold text-gray-900">Dashboard</h1>\n          <p className="text-muted-foreground text-sm mt-1">Manage your pro bono cases and get AI assistance</p>\n        </div>\n\n        {/* Stats */}\n        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">\n          {stats.map(({ label, value, icon: Icon, color, bg }) => (\n            <div key={label} className="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">\n              <div className={`inline-flex h-9 w-9 items-center justify-center rounded-lg ${bg} mb-3`}>\n                <Icon className={`h-4 w-4 ${color}`} />\n              </div>\n              <div className="text-2xl font-bold text-gray-900">{value}</div>\n              <div className="text-xs text-muted-foreground mt-0.5">{label}</div>\n            </div>\n          ))}\n        </div>\n\n        {/* Quick Actions */}\n        <div className="grid md:grid-cols-3 gap-4 mb-8">\n          <Link href="/chat" className="bg-brand-600 text-white rounded-xl p-5 hover:bg-brand-700 transition-colors">\n            <MessageSquare className="h-6 w-6 mb-3" />\n            <div className="font-semibold">Ask AI Assistant</div>\n            <div className="text-sm text-brand-100 mt-1">Get legal information & guidance</div>\n          </Link>\n          <Link href="/cases/new" className="bg-white border border-gray-200 rounded-xl p-5 hover:bg-gray-50 transition-colors">\n            <Plus className="h-6 w-6 mb-3 text-gray-600" />\n            <div className="font-semibold text-gray-900">Open a New Case</div>\n            <div className="text-sm text-muted-foreground mt-1">Start a new legal matter</div>\n          </Link>\n          <Link href="/documents" className="bg-white border border-gray-200 rounded-xl p-5 hover:bg-gray-50 transition-colors">\n            <Upload className="h-6 w-6 mb-3 text-gray-600" />\n            <div className="font-semibold text-gray-900">Upload Documents</div>\n            <div className="text-sm text-muted-foreground mt-1">Add files for AI analysis</div>\n          </Link>\n        </div>\n\n        {/* Recent Cases */}\n        <div className="bg-white rounded-xl border border-gray-100 shadow-sm">\n          <div className="px-5 py-4 border-b flex items-center justify-between">\n            <h2 className="font-semibold text-gray-900">Recent Cases</h2>\n            <Link href="/cases" className="text-sm text-brand-600 hover:text-brand-700">View all</Link>\n          </div>\n          {cases.length === 0 ? (\n            <div className="px-5 py-10 text-center text-muted-foreground text-sm">\n              No cases yet.{" "}\n              <Link href="/cases/new" className="text-brand-600 hover:underline">Open your first case â†’</Link>\n            </div>\n          ) : (\n            <ul className="divide-y">\n              {cases.slice(0, 5).map((c) => (\n                <li key={c.id}>\n                  <Link href={`/cases/${c.id}`} className="flex items-center justify-between px-5 py-3.5 hover:bg-gray-50 transition-colors">\n                    <div>\n                      <div className="font-medium text-sm text-gray-900">{c.title}</div>\n                      <div className="text-xs text-muted-foreground mt-0.5">{c.category}</div>\n                    </div>\n                    <span className={`text-xs font-medium px-2.5 py-1 rounded-full ${STATUS_COLORS[c.status]}`}>\n                      {c.status.replace("_", " ")}\n                    </span>\n                  </Link>\n                </li>\n              ))}\n            </ul>\n          )}\n        </div>\n      </main>\n    </div>\n  );\n}\n',
    'jroc-ai-pro-bono/frontend/src/app/chat/page.tsx': '"use client";\n\nimport { useState, useRef, useEffect } from "react";\nimport { useRouter, useSearchParams } from "next/navigation";\nimport ReactMarkdown from "react-markdown";\nimport remarkGfm from "remark-gfm";\nimport { Send, Loader2, Scale, AlertTriangle, BookOpen, FileEdit, ClipboardList } from "lucide-react";\nimport { sendMessage } from "@/lib/api";\nimport type { Message } from "@/types";\nimport { formatDate } from "@/lib/utils";\n\nconst AGENT_META: Record<string, { label: string; icon: any; color: string }> = {\n  legal_research: { label: "Legal Research", icon: BookOpen,     color: "text-blue-600" },\n  intake:         { label: "Case Intake",     icon: ClipboardList, color: "text-purple-600" },\n  drafting:       { label: "Document Draft", icon: FileEdit,      color: "text-green-600" },\n  escalation:     { label: "Urgent / Crisis", icon: AlertTriangle, color: "text-red-600" },\n};\n\nexport default function ChatPage() {\n  const router = useRouter();\n  const searchParams = useSearchParams();\n  const caseId = searchParams.get("caseId") || undefined;\n\n  const [messages, setMessages] = useState<Message[]>([]);\n  const [input, setInput] = useState("");\n  const [conversationId, setConversationId] = useState<string | undefined>();\n  const [loading, setLoading] = useState(false);\n  const bottomRef = useRef<HTMLDivElement>(null);\n  const textareaRef = useRef<HTMLTextAreaElement>(null);\n\n  useEffect(() => {\n    bottomRef.current?.scrollIntoView({ behavior: "smooth" });\n  }, [messages]);\n\n  useEffect(() => {\n    const token = localStorage.getItem("jroc_token");\n    if (!token) router.push("/login");\n  }, [router]);\n\n  // Auto-resize textarea\n  useEffect(() => {\n    if (textareaRef.current) {\n      textareaRef.current.style.height = "auto";\n      textareaRef.current.style.height = Math.min(textareaRef.current.scrollHeight, 160) + "px";\n    }\n  }, [input]);\n\n  async function handleSend() {\n    if (!input.trim() || loading) return;\n    const userMessage = input.trim();\n    setInput("");\n\n    const userMsg: Message = {\n      id: Date.now().toString(),\n      conversation_id: conversationId || "",\n      role: "user",\n      content: userMessage,\n      created_at: new Date().toISOString(),\n    };\n    setMessages((prev) => [...prev, userMsg]);\n    setLoading(true);\n\n    try {\n      const data = await sendMessage(userMessage, conversationId, caseId);\n      if (!conversationId) setConversationId(data.conversation_id);\n\n      const assistantMsg: Message = {\n        id: data.message_id,\n        conversation_id: data.conversation_id,\n        role: "assistant",\n        content: data.reply,\n        created_at: data.created_at,\n        metadata: { agent: data.agent_used, sources: data.sources },\n      };\n      setMessages((prev) => [...prev, assistantMsg]);\n    } catch {\n      setMessages((prev) => [\n        ...prev,\n        {\n          id: Date.now().toString(),\n          conversation_id: conversationId || "",\n          role: "assistant",\n          content: "âš ï¸ Something went wrong. Please try again.",\n          created_at: new Date().toISOString(),\n        },\n      ]);\n    } finally {\n      setLoading(false);\n    }\n  }\n\n  function handleKeyDown(e: React.KeyboardEvent) {\n    if (e.key === "Enter" && !e.shiftKey) {\n      e.preventDefault();\n      handleSend();\n    }\n  }\n\n  return (\n    <div className="flex flex-col h-screen bg-gray-50">\n      {/* Header */}\n      <header className="bg-white border-b px-4 h-14 flex items-center justify-between shrink-0">\n        <div className="flex items-center gap-2 font-bold text-brand-700">\n          <Scale className="h-5 w-5" />\n          AI Assistant\n          {caseId && <span className="text-xs font-normal text-muted-foreground ml-2">Case context active</span>}\n        </div>\n        <button\n          onClick={() => router.push("/dashboard")}\n          className="text-sm text-muted-foreground hover:text-foreground"\n        >\n          â† Dashboard\n        </button>\n      </header>\n\n      {/* Messages */}\n      <div className="flex-1 overflow-y-auto px-4 py-6 space-y-4">\n        {messages.length === 0 && (\n          <div className="text-center py-16">\n            <div className="inline-flex h-16 w-16 items-center justify-center bg-brand-100 rounded-2xl mb-4">\n              <Scale className="h-8 w-8 text-brand-600" />\n            </div>\n            <h2 className="text-xl font-semibold text-gray-900 mb-2">How can I help you today?</h2>\n            <p className="text-muted-foreground text-sm max-w-md mx-auto">\n              Ask about your legal rights, get help drafting a letter, or describe your situation for guidance.\n            </p>\n            <div className="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-2 max-w-lg mx-auto text-left">\n              {[\n                "My landlord won\'t fix the heat. What are my rights?",\n                "Help me write a demand letter to my employer.",\n                "I received an eviction notice â€” what do I do?",\n                "What is the statute of limitations for wage theft?",\n              ].map((suggestion) => (\n                <button\n                  key={suggestion}\n                  onClick={() => { setInput(suggestion); textareaRef.current?.focus(); }}\n                  className="text-sm text-left border border-gray-200 rounded-lg px-3 py-2.5 hover:bg-white hover:border-brand-300 transition-colors text-gray-700"\n                >\n                  {suggestion}\n                </button>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {messages.map((msg) => {\n          const isUser = msg.role === "user";\n          const agentMeta = msg.metadata?.agent ? AGENT_META[msg.metadata.agent] : null;\n          return (\n            <div key={msg.id} className={`flex ${isUser ? "justify-end" : "justify-start"}`}>\n              <div className={`max-w-2xl ${isUser ? "items-end" : "items-start"} flex flex-col gap-1`}>\n                {!isUser && agentMeta && (\n                  <div className={`flex items-center gap-1 text-xs font-medium ${agentMeta.color}`}>\n                    <agentMeta.icon className="h-3 w-3" />\n                    {agentMeta.label}\n                  </div>\n                )}\n                <div\n                  className={`rounded-2xl px-4 py-3 text-sm ${\n                    isUser\n                      ? "bg-brand-600 text-white rounded-br-sm"\n                      : "bg-white border border-gray-100 shadow-sm rounded-bl-sm text-gray-900"\n                  }`}\n                >\n                  {isUser ? (\n                    <p>{msg.content}</p>\n                  ) : (\n                    <div className="prose-chat">\n                      <ReactMarkdown remarkPlugins={[remarkGfm]}>{msg.content}</ReactMarkdown>\n                    </div>\n                  )}\n                </div>\n                {msg.metadata?.sources && msg.metadata.sources.length > 0 && (\n                  <div className="text-xs text-muted-foreground mt-0.5">\n                    ðŸ“„ {msg.metadata.sources.length} source{msg.metadata.sources.length !== 1 ? "s" : ""} referenced\n                  </div>\n                )}\n                <div className="text-xs text-muted-foreground">{formatDate(msg.created_at)}</div>\n              </div>\n            </div>\n          );\n        })}\n\n        {loading && (\n          <div className="flex justify-start">\n            <div className="bg-white border border-gray-100 shadow-sm rounded-2xl rounded-bl-sm px-4 py-3">\n              <div className="flex items-center gap-2 text-muted-foreground text-sm">\n                <Loader2 className="h-4 w-4 animate-spin" />\n                Thinkingâ€¦\n              </div>\n            </div>\n          </div>\n        )}\n\n        <div ref={bottomRef} />\n      </div>\n\n      {/* Input */}\n      <div className="bg-white border-t px-4 py-3 shrink-0">\n        <div className="max-w-3xl mx-auto flex items-end gap-2">\n          <div className="flex-1 border border-gray-300 rounded-xl px-3 py-2 focus-within:ring-2 focus-within:ring-brand-500 focus-within:border-transparent">\n            <textarea\n              ref={textareaRef}\n              value={input}\n              onChange={(e) => setInput(e.target.value)}\n              onKeyDown={handleKeyDown}\n              placeholder="Describe your situation or ask a legal questionâ€¦"\n              rows={1}\n              className="w-full resize-none outline-none text-sm text-gray-900 placeholder-muted-foreground bg-transparent"\n            />\n          </div>\n          <button\n            onClick={handleSend}\n            disabled={!input.trim() || loading}\n            className="h-10 w-10 flex items-center justify-center bg-brand-600 text-white rounded-xl hover:bg-brand-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors shrink-0"\n          >\n            <Send className="h-4 w-4" />\n          </button>\n        </div>\n        <p className="text-center text-xs text-muted-foreground mt-2">\n          AI responses are for informational purposes only and are not legal advice.\n        </p>\n      </div>\n    </div>\n  );\n}\n',
    'jroc-ai-pro-bono/frontend/src/app/register/page.tsx': '"use client";\n\nimport { useState } from "react";\nimport Link from "next/link";\nimport { useRouter } from "next/navigation";\nimport { Scale, Eye, EyeOff, Loader2 } from "lucide-react";\nimport { register } from "@/lib/api";\n\nexport default function RegisterPage() {\n  const router = useRouter();\n  const [email, setEmail] = useState("");\n  const [password, setPassword] = useState("");\n  const [confirm, setConfirm] = useState("");\n  const [showPassword, setShowPassword] = useState(false);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState("");\n\n  async function handleSubmit(e: React.FormEvent) {\n    e.preventDefault();\n    setError("");\n    if (password !== confirm) {\n      setError("Passwords do not match.");\n      return;\n    }\n    if (password.length < 8) {\n      setError("Password must be at least 8 characters.");\n      return;\n    }\n    setLoading(true);\n    try {\n      const data = await register(email, password);\n      localStorage.setItem("jroc_token", data.access_token);\n      router.push("/dashboard");\n    } catch (err: any) {\n      setError(err.message || "Registration failed. Please try again.");\n    } finally {\n      setLoading(false);\n    }\n  }\n\n  return (\n    <div className="min-h-screen bg-gradient-to-br from-brand-50 to-white flex items-center justify-center p-4">\n      <div className="w-full max-w-md">\n        <div className="text-center mb-8">\n          <div className="inline-flex items-center justify-center h-14 w-14 bg-brand-600 rounded-2xl mb-4">\n            <Scale className="h-7 w-7 text-white" />\n          </div>\n          <h1 className="text-2xl font-bold text-gray-900">Get free legal help</h1>\n          <p className="text-muted-foreground text-sm mt-1">Create your account â€” it\'s completely free</p>\n        </div>\n\n        <div className="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">\n          {error && (\n            <div className="mb-4 p-3 bg-destructive/10 text-destructive text-sm rounded-lg">\n              {error}\n            </div>\n          )}\n\n          <form onSubmit={handleSubmit} className="space-y-4">\n            <div>\n              <label className="block text-sm font-medium text-gray-700 mb-1.5">Email address</label>\n              <input\n                type="email"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                required\n                placeholder="you@example.com"\n                className="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"\n              />\n            </div>\n\n            <div>\n              <label className="block text-sm font-medium text-gray-700 mb-1.5">Password</label>\n              <div className="relative">\n                <input\n                  type={showPassword ? "text" : "password"}\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  required\n                  placeholder="Min. 8 characters"\n                  className="w-full border border-gray-300 rounded-lg px-3 py-2.5 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"\n                />\n                <button\n                  type="button"\n                  onClick={() => setShowPassword(!showPassword)}\n                  className="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-gray-700"\n                >\n                  {showPassword ? <EyeOff className="h-4 w-4" /> : <Eye className="h-4 w-4" />}\n                </button>\n              </div>\n            </div>\n\n            <div>\n              <label className="block text-sm font-medium text-gray-700 mb-1.5">Confirm password</label>\n              <input\n                type="password"\n                value={confirm}\n                onChange={(e) => setConfirm(e.target.value)}\n                required\n                placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢"\n                className="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"\n              />\n            </div>\n\n            <button\n              type="submit"\n              disabled={loading}\n              className="w-full bg-brand-600 text-white py-2.5 rounded-lg text-sm font-medium hover:bg-brand-700 transition-colors disabled:opacity-60 flex items-center justify-center gap-2"\n            >\n              {loading && <Loader2 className="h-4 w-4 animate-spin" />}\n              {loading ? "Creating accountâ€¦" : "Create Free Account"}\n            </button>\n          </form>\n\n          <p className="text-center text-xs text-muted-foreground mt-4">\n            By registering, you agree that this service provides informational assistance only and is not a substitute for licensed legal counsel.\n          </p>\n\n          <p className="text-center text-sm text-muted-foreground mt-4">\n            Already have an account?{" "}\n            <Link href="/login" className="text-brand-600 hover:text-brand-700 font-medium">\n              Sign in\n            </Link>\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n}\n',
    'jroc-ai-pro-bono/frontend/src/app/login/page.tsx': '"use client";\n\nimport { useState } from "react";\nimport Link from "next/link";\nimport { useRouter } from "next/navigation";\nimport { Scale, Eye, EyeOff, Loader2 } from "lucide-react";\nimport { login } from "@/lib/api";\n\nexport default function LoginPage() {\n  const router = useRouter();\n  const [email, setEmail] = useState("");\n  const [password, setPassword] = useState("");\n  const [showPassword, setShowPassword] = useState(false);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState("");\n\n  async function handleSubmit(e: React.FormEvent) {\n    e.preventDefault();\n    setError("");\n    setLoading(true);\n    try {\n      const data = await login(email, password);\n      localStorage.setItem("jroc_token", data.access_token);\n      router.push("/dashboard");\n    } catch (err: any) {\n      setError(err.message || "Login failed. Please try again.");\n    } finally {\n      setLoading(false);\n    }\n  }\n\n  return (\n    <div className="min-h-screen bg-gradient-to-br from-brand-50 to-white flex items-center justify-center p-4">\n      <div className="w-full max-w-md">\n        <div className="text-center mb-8">\n          <div className="inline-flex items-center justify-center h-14 w-14 bg-brand-600 rounded-2xl mb-4">\n            <Scale className="h-7 w-7 text-white" />\n          </div>\n          <h1 className="text-2xl font-bold text-gray-900">Welcome back</h1>\n          <p className="text-muted-foreground text-sm mt-1">Sign in to your account</p>\n        </div>\n\n        <div className="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">\n          {error && (\n            <div className="mb-4 p-3 bg-destructive/10 text-destructive text-sm rounded-lg">\n              {error}\n            </div>\n          )}\n\n          <form onSubmit={handleSubmit} className="space-y-4">\n            <div>\n              <label className="block text-sm font