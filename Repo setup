    'jroc-ai-pro-bono/backend/app/ingestion/embedder.py': '"""\nEmbedder â€” generates OpenAI embeddings for text chunks in batches.\n"""\n\nfrom typing import List\nimport asyncio\nfrom openai import AsyncOpenAI\n\nfrom app.core.config import settings\nfrom app.core.logging import logger\n\nBATCH_SIZE = 100  # OpenAI allows up to 2048 items per request; 100 is safe\n\n\nclass Embedder:\n    def __init__(self):\n        self.client = AsyncOpenAI(api_key=settings.OPENAI_API_KEY)\n        self.model = settings.OPENAI_EMBEDDING_MODEL\n\n    async def embed_batch(self, texts: List[str]) -> List[List[float]]:\n        """Embed a batch of texts and return their vectors."""\n        if not texts:\n            return []\n        response = await self.client.embeddings.create(\n            model=self.model,\n            input=texts,\n        )\n        # Return in same order as input\n        return [item.embedding for item in sorted(response.data, key=lambda x: x.index)]\n\n    async def embed_all(self, texts: List[str]) -> List[List[float]]:\n        """Embed all texts, batching to stay within API limits."""\n        all_embeddings: List[List[float]] = []\n        for i in range(0, len(texts), BATCH_SIZE):\n            batch = texts[i : i + BATCH_SIZE]\n            logger.debug(f"Embedding batch {i // BATCH_SIZE + 1} ({len(batch)} chunks)")\n            embeddings = await self.embed_batch(batch)\n            all_embeddings.extend(embeddings)\n            # Brief pause to avoid rate limiting\n            if i + BATCH_SIZE < len(texts):\n                await asyncio.sleep(0.1)\n        return all_embeddings\n',
    'jroc-ai-pro-bono/backend/app/ingestion/parser.py': '"""\nDocument parsers â€” extract plain text from PDF, DOCX, TXT, and MD files.\n"""\n\nfrom pathlib import Path\nfrom typing import Optional\n\n\ndef parse_document(file_path: str) -> str:\n    """\n    Extract plain text from a document file.\n    Dispatches to the appropriate parser based on file extension.\n    """\n    path = Path(file_path)\n    ext = path.suffix.lower().lstrip(".")\n\n    parsers = {\n        "pdf": _parse_pdf,\n        "docx": _parse_docx,\n        "txt": _parse_text,\n        "md": _parse_text,\n    }\n\n    parser = parsers.get(ext)\n    if not parser:\n        raise ValueError(f"Unsupported file type: {ext}")\n\n    return parser(str(path))\n\n\ndef _parse_pdf(file_path: str) -> str:\n    """Extract text from a PDF using pypdf."""\n    from pypdf import PdfReader\n    reader = PdfReader(file_path)\n    pages = []\n    for page in reader.pages:\n        text = page.extract_text()\n        if text:\n            pages.append(text.strip())\n    return "\\n\\n".join(pages)\n\n\ndef _parse_docx(file_path: str) -> str:\n    """Extract text from a DOCX file using python-docx."""\n    from docx import Document\n    doc = Document(file_path)\n    paragraphs = [p.text for p in doc.paragraphs if p.text.strip()]\n    return "\\n\\n".join(paragraphs)\n\n\ndef _parse_text(file_path: str) -> str:\n    """Read plain text or markdown files."""\n    with open(file_path, "r", encoding="utf-8", errors="replace") as f:\n        return f.read()\n',
    'jroc-ai-pro-bono/backend/app/agents/drafting.py': '"""\nDraftingAgent â€” generates professional legal documents, letters, and summaries.\n"""\n\nfrom typing import Any\nfrom langchain_openai import ChatOpenAI\nfrom langchain_core.messages import HumanMessage, SystemMessage\n\nfrom app.core.config import settings\n\nSYSTEM_PROMPT = """You are an expert legal document drafter for a pro bono legal aid service.\nYou produce clear, professional, and legally sound written documents for clients.\n\nDocument types you can draft:\n- Demand letters (housing repairs, wage theft, debt disputes)\n- Complaint letters (to agencies, landlords, employers)\n- Case summaries and incident timelines\n- Motion outlines and brief structures\n- Reasonable accommodation requests\n- Cease and desist letters\n\nFormatting rules:\n- Use proper legal letter format (date, parties, subject, body, closing)\n- Use clear section headers for longer documents\n- Use plain language where possible, legal terminology where necessary\n- Include placeholders in [BRACKETS] for case-specific details the client must fill in\n- Always add a disclaimer: "This document was prepared with AI assistance for informational purposes only and does not constitute legal advice."\n"""\n\n\nclass DraftingAgent:\n    def __init__(self, db: Any):\n        self.db = db\n        self.llm = ChatOpenAI(\n            model=settings.OPENAI_CHAT_MODEL,\n            temperature=0.4,\n            max_tokens=settings.OPENAI_MAX_TOKENS,\n            api_key=settings.OPENAI_API_KEY,\n        )\n\n    async def run(\n        self,\n        user_message: str,\n        history: list[dict],\n        case_id: str | None = None,\n        user_id: str | None = None,\n    ) -> dict:\n        # Pull case context if available\n        case_context = ""\n        if case_id and self.db:\n            try:\n                resp = self.db.table("cases").select("title,description,category").eq("id", case_id).single().execute()\n                if resp.data:\n                    c = resp.data\n                    case_context = f"\\nCase context: {c[\'title\']} â€” {c[\'description\'][:300]}\\nCategory: {c[\'category\']}\\n"\n            except Exception:\n                pass\n\n        messages = [SystemMessage(content=SYSTEM_PROMPT + case_context)]\n        for msg in history[-6:]:\n            role_cls = HumanMessage if msg["role"] == "user" else SystemMessage\n            messages.append(role_cls(content=msg["content"]))\n        messages.append(HumanMessage(content=user_message))\n\n        response = await self.llm.ainvoke(messages)\n        return {"reply": response.content, "sources": []}\n',
    'jroc-ai-pro-bono/backend/app/agents/supervisor.py': '"""\nSupervisorAgent â€” routes user queries to the appropriate specialist agent.\n\nArchitecture:\n  User Query â†’ SupervisorAgent â†’ [LegalResearchAgent | IntakeAgent |\n                                   DraftingAgent | EscalationAgent]\n"""\n\nfrom typing import Any\n\nfrom langchain_openai import ChatOpenAI\nfrom langchain_core.messages import HumanMessage, SystemMessage\n\nfrom app.core.config import settings\nfrom app.core.logging import logger\nfrom app.agents.legal_research import LegalResearchAgent\nfrom app.agents.intake import IntakeAgent\nfrom app.agents.drafting import DraftingAgent\nfrom app.agents.escalation import EscalationAgent\n\n\nSUPERVISOR_SYSTEM_PROMPT = """You are a routing supervisor for an AI pro bono legal assistant service.\n\nYour ONLY job is to classify the user\'s intent and output exactly one of these routing decisions:\n- LEGAL_RESEARCH  â€” user needs information about laws, rights, precedents, or policies\n- INTAKE          â€” user is providing case details or answering intake questions\n- DRAFTING        â€” user wants help writing a letter, motion, complaint, or summary\n- ESCALATION      â€” user describes an emergency, abuse, safety threat, or time-sensitive legal deadline\n\nRespond with ONLY the routing label and nothing else. No explanations."""\n\n\nclass SupervisorAgent:\n    """Orchestrates specialist agents based on user intent classification."""\n\n    def __init__(self, db: Any, user_id: str):\n        self.db = db\n        self.user_id = user_id\n        self.llm = ChatOpenAI(\n            model=settings.OPENAI_CHAT_MODEL,\n            temperature=0,\n            api_key=settings.OPENAI_API_KEY,\n        )\n        self._agents = {\n            "LEGAL_RESEARCH": LegalResearchAgent(db=db),\n            "INTAKE": IntakeAgent(db=db),\n            "DRAFTING": DraftingAgent(db=db),\n            "ESCALATION": EscalationAgent(db=db),\n        }\n\n    async def _classify(self, user_message: str, history: list[dict]) -> str:\n        """Classify the user\'s intent to select the right specialist."""\n        recent = " | ".join(\n            f"{m[\'role\']}: {m[\'content\'][:100]}" for m in history[-4:]\n        )\n        messages = [\n            SystemMessage(content=SUPERVISOR_SYSTEM_PROMPT),\n            HumanMessage(content=f"Context: {recent}\\n\\nCurrent message: {user_message}"),\n        ]\n        response = await self.llm.ainvoke(messages)\n        label = response.content.strip().upper()\n        valid = set(self._agents.keys())\n        return label if label in valid else "LEGAL_RESEARCH"\n\n    async def run(\n        self,\n        user_message: str,\n        history: list[dict],\n        case_id: str | None = None,\n    ) -> dict:\n        """Route the query and return the specialist\'s response."""\n        agent_key = await self._classify(user_message, history)\n        logger.info(f"Supervisor routed to: {agent_key}")\n\n        agent = self._agents[agent_key]\n        result = await agent.run(\n            user_message=user_message,\n            history=history,\n            case_id=case_id,\n            user_id=self.user_id,\n        )\n        result["agent_used"] = agent_key.lower()\n        return result\n',
    'jroc-ai-pro-bono/backend/app/agents/intake.py': '"""\nIntakeAgent â€” collects structured case information from clients\nthrough a guided conversational intake form.\n"""\n\nfrom typing import Any\nfrom langchain_openai import ChatOpenAI\nfrom langchain_core.messages import HumanMessage, SystemMessage\n\nfrom app.core.config import settings\n\nSYSTEM_PROMPT = """You are a compassionate intake specialist for a pro bono legal aid service.\nYour goal is to gather the essential information needed to open a case file.\n\nCollect the following information (one or two questions at a time â€” don\'t overwhelm):\n1. Full name and preferred contact\n2. Nature of the legal issue (housing, employment, family, immigration, criminal, civil, other)\n3. Jurisdiction / state where the issue occurred\n4. Key dates and deadlines (court dates, lease end dates, filing deadlines)\n5. Opposing party (landlord, employer, government agency, etc.)\n6. Any prior legal proceedings or attorneys involved\n7. Urgency level and immediate safety concerns\n\nBe warm, patient, and trauma-informed. Use plain language. Reassure the client their information is confidential.\nOnce all required information is collected, summarize it clearly and confirm with the client.\n"""\n\n\nclass IntakeAgent:\n    def __init__(self, db: Any):\n        self.db = db\n        self.llm = ChatOpenAI(\n            model=settings.OPENAI_CHAT_MODEL,\n            temperature=0.3,\n            api_key=settings.OPENAI_API_KEY,\n        )\n\n    async def run(\n        self,\n        user_message: str,\n        history: list[dict],\n        case_id: str | None = None,\n        user_id: str | None = None,\n    ) -> dict:\n        messages = [SystemMessage(content=SYSTEM_PROMPT)]\n        for msg in history[-8:]:\n            role_cls = HumanMessage if msg["role"] == "user" else SystemMessage\n            messages.append(role_cls(content=msg["content"]))\n        messages.append(HumanMessage(content=user_message))\n\n        response = await self.llm.ainvoke(messages)\n        return {"reply": response.content, "sources": []}\n',
    'jroc-ai-pro-bono/backend/app/agents/escalation.py': '"""\nEscalationAgent â€” detects emergencies, safety threats, and hard legal deadlines.\nFlags cases for immediate human attorney review.\n"""\n\nfrom typing import Any\nfrom datetime import datetime, timezone\nfrom langchain_openai import ChatOpenAI\nfrom langchain_core.messages import HumanMessage, SystemMessage\n\nfrom app.core.config import settings\nfrom app.core.logging import logger\n\nSYSTEM_PROMPT = """You are a crisis triage specialist for a pro bono legal aid service.\nYou handle urgent, high-stakes, and emergency situations.\n\nYour responsibilities:\n1. Acknowledge the urgency and validate the client\'s feelings\n2. Provide immediate safety resources if there is any physical danger\n3. Identify the specific legal emergency (eviction lockout, domestic violence, imminent arrest, child custody emergency, etc.)\n4. Give concrete, actionable next steps the client can take RIGHT NOW\n5. Collect key information to escalate to a human attorney within 24 hours\n\nEmergency resources to provide when relevant:\n- National Domestic Violence Hotline: 1-800-799-7233\n- Legal Aid Society (general): 1-800-342-3661\n- 211 (local social services): dial 2-1-1\n- Emergency housing: suggest local shelter search via 211\n\nALWAYS end your response by telling the client their case has been flagged for urgent attorney review.\n"""\n\n\nclass EscalationAgent:\n    def __init__(self, db: Any):\n        self.db = db\n        self.llm = ChatOpenAI(\n            model=settings.OPENAI_CHAT_MODEL,\n            temperature=0.1,\n            api_key=settings.OPENAI_API_KEY,\n        )\n\n    async def _flag_for_review(self, user_id: str, message: str, case_id: str | None) -> None:\n        """Mark the case as escalated in the database."""\n        if not self.db:\n            return\n        try:\n            if case_id:\n                self.db.table("cases").update({\n                    "status": "escalated",\n                    "updated_at": datetime.now(timezone.utc).isoformat(),\n                }).eq("id", case_id).execute()\n            # Log the escalation event\n            self.db.table("escalation_events").insert({\n                "user_id": user_id,\n                "case_id": case_id,\n                "trigger_message": message[:500],\n                "created_at": datetime.now(timezone.utc).isoformat(),\n            }).execute()\n        except Exception as exc:\n            logger.warning(f"Failed to log escalation: {exc}")\n\n    async def run(\n        self,\n        user_message: str,\n        history: list[dict],\n        case_id: str | None = None,\n        user_id: str | None = None,\n    ) -> dict:\n        if user_id:\n            await self._flag_for_review(user_id, user_message, case_id)\n\n        messages = [SystemMessage(content=SYSTEM_PROMPT)]\n        for msg in history[-4:]:\n            role_cls = HumanMessage if msg["role"] == "user" else SystemMessage\n            messages.append(role_cls(content=msg["content"]))\n        messages.append(HumanMessage(content=user_message))\n\n        response = await self.llm.ainvoke(messages)\n        logger.warning(f"ESCALATION triggered for user={user_id} case={case_id}")\n        return {"reply": response.content, "sources": [], "escalated": True}\n',
    'jroc-ai-pro-bono/backend/app/agents/legal_research.py': '"""\nLegalResearchAgent â€” searches the vector store for relevant legal documents\nand synthesizes an evidence-backed answer.\n"""\n\nfrom typing import Any\nfrom langchain_openai import ChatOpenAI\nfrom langchain_core.messages import HumanMessage, SystemMessage\n\nfrom app.core.config import settings\nfrom app.services.vector_search import VectorSearchService\n\nSYSTEM_PROMPT = """You are a knowledgeable pro bono legal research assistant.\nYour role is to help underserved community members understand their legal rights and options.\n\nGuidelines:\n- Explain legal concepts in plain, accessible language\n- Always cite the source documents you reference\n- Clarify you are not providing legal advice and recommend consulting a licensed attorney for case-specific guidance\n- Be empathetic and non-judgmental\n- When unsure, say so â€” accuracy matters more than confidence\n"""\n\n\nclass LegalResearchAgent:\n    def __init__(self, db: Any):\n        self.db = db\n        self.llm = ChatOpenAI(\n            model=settings.OPENAI_CHAT_MODEL,\n            temperature=settings.OPENAI_TEMPERATURE,\n            api_key=settings.OPENAI_API_KEY,\n        )\n        self.search = VectorSearchService(db=db)\n\n    async def run(\n        self,\n        user_message: str,\n        history: list[dict],\n        case_id: str | None = None,\n        user_id: str | None = None,\n    ) -> dict:\n        # Retrieve relevant document chunks\n        chunks = await self.search.search(query=user_message)\n\n        # Build context from retrieved chunks\n        context_parts = []\n        sources = []\n        for i, chunk in enumerate(chunks, 1):\n            context_parts.append(f"[Source {i}]: {chunk[\'content\']}")\n            sources.append({\n                "id": chunk.get("document_id"),\n                "title": chunk.get("document_title", "Unknown"),\n                "relevance": chunk.get("similarity", 0),\n            })\n\n        context = "\\n\\n".join(context_parts) if context_parts else "No relevant documents found."\n\n        # Build conversation history\n        messages = [SystemMessage(content=SYSTEM_PROMPT)]\n        for msg in history[-6:]:\n            if msg["role"] == "user":\n                messages.append(HumanMessage(content=msg["content"]))\n            # assistant messages handled via AIMessage in full implementation\n\n        # Final user query with context\n        augmented_query = (\n            f"Reference documents:\\n{context}\\n\\n"\n            f"User question: {user_message}"\n        )\n        messages.append(HumanMessage(content=augmented_query))\n\n        response = await self.llm.ainvoke(messages)\n        return {"reply": response.content, "sources": sources}\n',
