    'jroc-ai-pro-bono/backend/app/ingestion/chunker.py': '"""\nDocument chunking utilities â€” splits documents into overlapping chunks\nsuitable for embedding and vector search.\n"""\n\nfrom typing import List\nimport tiktoken\n\nDEFAULT_CHUNK_SIZE = 512      # tokens\nDEFAULT_CHUNK_OVERLAP = 64    # tokens\n\n\ndef get_tokenizer(model: str = "text-embedding-3-small"):\n    """Return the tiktoken encoder for the given model."""\n    try:\n        return tiktoken.encoding_for_model(model)\n    except KeyError:\n        return tiktoken.get_encoding("cl100k_base")\n\n\ndef chunk_text(\n    text: str,\n    chunk_size: int = DEFAULT_CHUNK_SIZE,\n    chunk_overlap: int = DEFAULT_CHUNK_OVERLAP,\n) -> List[str]:\n    """\n    Split text into overlapping token-based chunks.\n\n    Args:\n        text:           The full document text.\n        chunk_size:     Target chunk size in tokens.\n        chunk_overlap:  Number of overlapping tokens between consecutive chunks.\n\n    Returns:\n        List of text chunk strings.\n    """\n    enc = get_tokenizer()\n    tokens = enc.encode(text)\n\n    if len(tokens) <= chunk_size:\n        return [text] if text.strip() else []\n\n    chunks = []\n    start = 0\n    while start < len(tokens):\n        end = min(start + chunk_size, len(tokens))\n        chunk_tokens = tokens[start:end]\n        chunk_text = enc.decode(chunk_tokens)\n        if chunk_text.strip():\n            chunks.append(chunk_text.strip())\n        if end == len(tokens):\n            break\n        start += chunk_size - chunk_overlap\n\n    return chunks\n',
    'jroc-ai-pro-bono/backend/app/ingestion/tasks.py': '"""\nCelery tasks â€” async document ingestion pipeline.\n"""\n\nimport asyncio\nimport uuid\nfrom datetime import datetime, timezone\n\nfrom app.core.celery_app import celery_app\nfrom app.core.database import get_supabase\nfrom app.core.logging import logger\nfrom app.ingestion.parser import parse_document\nfrom app.ingestion.chunker import chunk_text\nfrom app.ingestion.embedder import Embedder\n\n\n@celery_app.task(bind=True, max_retries=3, default_retry_delay=60)\ndef ingest_document_task(self, document_id: str, file_path: str, user_id: str):\n    """\n    Full ingestion pipeline:\n      1. Parse document â†’ extract text\n      2. Chunk text into token-based segments\n      3. Generate embeddings via OpenAI\n      4. Upsert chunks into Supabase (document_chunks table)\n      5. Update document status\n    """\n    db = get_supabase()\n\n    try:\n        # Mark as processing\n        db.table("documents").update({\n            "status": "processing",\n            "updated_at": datetime.now(timezone.utc).isoformat(),\n        }).eq("id", document_id).execute()\n\n        logger.info(f"[Ingestion] Parsing document {document_id}")\n        text = parse_document(file_path)\n        if not text.strip():\n            raise ValueError("Document is empty or could not be parsed")\n\n        logger.info(f"[Ingestion] Chunking {len(text)} chars")\n        chunks = chunk_text(text)\n        if not chunks:\n            raise ValueError("No chunks produced from document")\n\n        logger.info(f"[Ingestion] Embedding {len(chunks)} chunks")\n        embedder = Embedder()\n        embeddings = asyncio.run(embedder.embed_all(chunks))\n\n        # Build records to upsert\n        now = datetime.now(timezone.utc).isoformat()\n        records = []\n        for i, (chunk, embedding) in enumerate(zip(chunks, embeddings)):\n            records.append({\n                "id": str(uuid.uuid4()),\n                "document_id": document_id,\n                "user_id": user_id,\n                "content": chunk,\n                "embedding": embedding,\n                "chunk_index": i,\n                "created_at": now,\n            })\n\n        # Insert in batches of 50\n        batch_size = 50\n        for i in range(0, len(records), batch_size):\n            db.table("document_chunks").insert(records[i : i + batch_size]).execute()\n\n        # Mark as ready\n        db.table("documents").update({\n            "status": "ready",\n            "chunk_count": len(chunks),\n            "updated_at": datetime.now(timezone.utc).isoformat(),\n        }).eq("id", document_id).execute()\n\n        logger.info(f"[Ingestion] âœ… Document {document_id} ingested â€” {len(chunks)} chunks")\n\n    except Exception as exc:\n        logger.error(f"[Ingestion] âŒ Failed for {document_id}: {exc}")\n        db.table("documents").update({\n            "status": "failed",\n            "updated_at": datetime.now(timezone.utc).isoformat(),\n        }).eq("id", document_id).execute()\n        raise self.retry(exc=exc)\n',
    'jroc-ai-pro-bono/backend/app/ingestion/runner.py': '"""\nCLI runner â€” manually trigger document ingestion from the command line.\n\nUsage:\n    python -m app.ingestion.runner --file path/to/doc.pdf\n    python -m app.ingestion.runner --dir path/to/folder/\n"""\n\nimport argparse\nimport asyncio\nimport uuid\nfrom pathlib import Path\nfrom datetime import datetime, timezone\n\nfrom app.core.database import get_supabase\nfrom app.core.logging import logger, setup_logging\nfrom app.ingestion.parser import parse_document\nfrom app.ingestion.chunker import chunk_text\nfrom app.ingestion.embedder import Embedder\n\n\nasync def ingest_file(file_path: str, user_id: str = "cli-user") -> None:\n    db = get_supabase()\n    path = Path(file_path)\n\n    if not path.exists():\n        raise FileNotFoundError(f"File not found: {file_path}")\n\n    document_id = str(uuid.uuid4())\n    now = datetime.now(timezone.utc).isoformat()\n\n    # Create document record\n    db.table("documents").insert({\n        "id": document_id,\n        "user_id": user_id,\n        "filename": path.name,\n        "file_path": str(path.resolve()),\n        "file_type": path.suffix.lstrip(".").lower(),\n        "status": "processing",\n        "created_at": now,\n        "updated_at": now,\n    }).execute()\n\n    logger.info(f"Parsing: {path.name}")\n    text = parse_document(str(path))\n    chunks = chunk_text(text)\n    logger.info(f"Generated {len(chunks)} chunks")\n\n    embedder = Embedder()\n    embeddings = await embedder.embed_all(chunks)\n    logger.info(f"Embedded {len(embeddings)} chunks")\n\n    records = [\n        {\n            "id": str(uuid.uuid4()),\n            "document_id": document_id,\n            "user_id": user_id,\n            "content": chunk,\n            "embedding": emb,\n            "chunk_index": i,\n            "created_at": now,\n        }\n        for i, (chunk, emb) in enumerate(zip(chunks, embeddings))\n    ]\n\n    for i in range(0, len(records), 50):\n        db.table("document_chunks").insert(records[i : i + 50]).execute()\n\n    db.table("documents").update({\n        "status": "ready",\n        "chunk_count": len(chunks),\n        "updated_at": datetime.now(timezone.utc).isoformat(),\n    }).eq("id", document_id).execute()\n\n    logger.info(f"âœ… Ingested: {path.name} â†’ {document_id}")\n\n\nasync def ingest_directory(dir_path: str, user_id: str = "cli-user") -> None:\n    path = Path(dir_path)\n    supported = {".pdf", ".docx", ".txt", ".md"}\n    files = [f for f in path.iterdir() if f.is_file() and f.suffix.lower() in supported]\n    logger.info(f"Found {len(files)} files in {dir_path}")\n    for f in files:\n        await ingest_file(str(f), user_id=user_id)\n\n\nif __name__ == "__main__":\n    setup_logging()\n    parser = argparse.ArgumentParser(description="JROC Document Ingestion CLI")\n    parser.add_argument("--file", help="Path to a single document")\n    parser.add_argument("--dir", help="Path to a directory of documents")\n    parser.add_argument("--user", default="cli-user", help="User ID to associate with documents")\n    args = parser.parse_args()\n\n    if args.file:\n        asyncio.run(ingest_file(args.file, user_id=args.user))\n    elif args.dir:\n        asyncio.run(ingest_directory(args.dir, user_id=args.user))\n    else:\n        parser.print_help()\n',
