    'jroc-ai-pro-bono/backend/.env.example': '# ============================================================\n# Backend Environment Variables\n# Copy to .env â€” NEVER commit .env!\n# ============================================================\n\n# --- App ---\nENVIRONMENT=development\nDEBUG=true\nSECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars\nALLOWED_ORIGINS=http://localhost:3000\n\n# --- Supabase ---\nSUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co\nSUPABASE_SERVICE_KEY=your-supabase-service-role-key\nSUPABASE_ANON_KEY=your-supabase-anon-key\n\n# --- OpenAI ---\nOPENAI_API_KEY=sk-your-openai-api-key\nOPENAI_EMBEDDING_MODEL=text-embedding-3-small\nOPENAI_CHAT_MODEL=gpt-4o\nOPENAI_MAX_TOKENS=2048\nOPENAI_TEMPERATURE=0.2\n\n# --- Redis (Celery) ---\nREDIS_URL=redis://redis:6379/0\n\n# --- Vector Search ---\nMATCH_THRESHOLD=0.75\nMATCH_COUNT=8\n\n# --- File Uploads ---\nUPLOAD_DIR=./uploads\nMAX_UPLOAD_SIZE_MB=50\nALLOWED_FILE_TYPES=pdf,docx,txt,md\n',
    'jroc-ai-pro-bono/backend/Dockerfile': 'FROM python:3.11-slim AS base\n\nWORKDIR /app\n\n# System dependencies\nRUN apt-get update && apt-get install -y \\\n    gcc \\\n    libpq-dev \\\n    curl \\\n    && rm -rf /var/lib/apt/lists/*\n\n# Python dependencies\nCOPY requirements.txt .\nRUN pip install --no-cache-dir -r requirements.txt\n\n# â”€â”€ Development stage â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nFROM base AS development\nCOPY . .\nCMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]\n\n# â”€â”€ Production stage â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nFROM base AS production\nCOPY . .\n# Create non-root user\nRUN addgroup --system appgroup && adduser --system --group appuser\nRUN chown -R appuser:appgroup /app\nUSER appuser\nCMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]\n',
    'jroc-ai-pro-bono/backend/tests/test_ingestion.py': '"""Tests for ingestion pipeline utilities."""\n\nimport pytest\nfrom app.ingestion.chunker import chunk_text\nfrom app.ingestion.parser import _parse_text\n\n\ndef test_chunk_text_short_document():\n    """Documents shorter than chunk_size return a single chunk."""\n    text = "This is a short document about tenant rights in Pennsylvania."\n    chunks = chunk_text(text, chunk_size=512)\n    assert len(chunks) == 1\n    assert chunks[0] == text.strip()\n\n\ndef test_chunk_text_produces_overlap():\n    """Long documents produce multiple overlapping chunks."""\n    # Generate ~2000 tokens of text\n    text = ("The tenant has the right to a habitable dwelling. " * 100)\n    chunks = chunk_text(text, chunk_size=200, chunk_overlap=40)\n    assert len(chunks) > 1\n\n\ndef test_chunk_text_empty_input():\n    """Empty text returns no chunks."""\n    assert chunk_text("") == []\n    assert chunk_text("   ") == []\n\n\ndef test_parse_text_file(tmp_path):\n    """Plain text parser reads file content correctly."""\n    content = "Test document content for JROC pro bono service."\n    f = tmp_path / "test.txt"\n    f.write_text(content)\n    result = _parse_text(str(f))\n    assert result == content\n',
    'jroc-ai-pro-bono/backend/tests/test_health.py': '"""Tests for health check endpoints."""\n\nimport pytest\nfrom httpx import AsyncClient\nfrom app.main import app\n\n\n@pytest.mark.asyncio\nasync def test_health_check():\n    async with AsyncClient(app=app, base_url="http://test") as client:\n        response = await client.get("/health")\n    assert response.status_code == 200\n    data = response.json()\n    assert data["status"] == "ok"\n    assert "version" in data\n    assert "environment" in data\n\n\n@pytest.mark.asyncio\nasync def test_root():\n    async with AsyncClient(app=app, base_url="http://test") as client:\n        response = await client.get("/")\n    assert response.status_code == 200\n    data = response.json()\n    assert "service" in data\n',
