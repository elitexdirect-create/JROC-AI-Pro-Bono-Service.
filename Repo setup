    'jroc-ai-pro-bono/backend/app/services/vector_search.py': '"""Vector similarity search service using Supabase pgvector RPC."""\n\nfrom typing import Any, List\nfrom openai import AsyncOpenAI\n\nfrom app.core.config import settings\nfrom app.core.logging import logger\n\n\nclass VectorSearchService:\n    """Embeds a query and searches the document_chunks table via pgvector."""\n\n    def __init__(self, db: Any):\n        self.db = db\n        self.openai = AsyncOpenAI(api_key=settings.OPENAI_API_KEY)\n\n    async def embed(self, text: str) -> List[float]:\n        """Generate an embedding vector for the given text."""\n        response = await self.openai.embeddings.create(\n            model=settings.OPENAI_EMBEDDING_MODEL,\n            input=text.strip(),\n        )\n        return response.data[0].embedding\n\n    async def search(\n        self,\n        query: str,\n        match_threshold: float | None = None,\n        match_count: int | None = None,\n    ) -> List[dict]:\n        """\n        Search document chunks using cosine similarity via the Supabase RPC\n        function `match_document_chunks`.\n        """\n        threshold = match_threshold or settings.MATCH_THRESHOLD\n        count = match_count or settings.MATCH_COUNT\n\n        try:\n            query_embedding = await self.embed(query)\n            response = self.db.rpc(\n                "match_document_chunks",\n                {\n                    "query_embedding": query_embedding,\n                    "match_threshold": threshold,\n                    "match_count": count,\n                },\n            ).execute()\n            return response.data or []\n        except Exception as exc:\n            logger.error(f"Vector search failed: {exc}")\n            return []\n',
    'jroc-ai-pro-bono/backend/app/models/schemas.py': '"""Pydantic request/response schemas."""\n\nfrom datetime import datetime\nfrom typing import List, Optional\nfrom pydantic import BaseModel, Field\nfrom enum import Enum\n\n\n# â”€â”€ Enums â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nclass CaseStatus(str, Enum):\n    OPEN = "open"\n    IN_PROGRESS = "in_progress"\n    ESCALATED = "escalated"\n    CLOSED = "closed"\n\n\nclass MessageRole(str, Enum):\n    USER = "user"\n    ASSISTANT = "assistant"\n    SYSTEM = "system"\n\n\nclass DocumentStatus(str, Enum):\n    PENDING = "pending"\n    PROCESSING = "processing"\n    READY = "ready"\n    FAILED = "failed"\n\n\n# â”€â”€ Auth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nclass TokenResponse(BaseModel):\n    access_token: str\n    token_type: str = "bearer"\n\n\nclass LoginRequest(BaseModel):\n    email: str\n    password: str\n\n\n# â”€â”€ Chat â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nclass ChatMessage(BaseModel):\n    role: MessageRole\n    content: str\n    created_at: Optional[datetime] = None\n\n\nclass ChatRequest(BaseModel):\n    conversation_id: Optional[str] = None\n    message: str = Field(..., min_length=1, max_length=4000)\n    case_id: Optional[str] = None\n\n\nclass ChatResponse(BaseModel):\n    conversation_id: str\n    message_id: str\n    reply: str\n    agent_used: str\n    sources: List[dict] = []\n    created_at: datetime\n\n\n# â”€â”€ Cases â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nclass CaseCreate(BaseModel):\n    title: str = Field(..., min_length=1, max_length=200)\n    description: str = Field(..., min_length=1, max_length=2000)\n    category: str\n    urgency: int = Field(default=3, ge=1, le=5)\n\n\nclass CaseUpdate(BaseModel):\n    title: Optional[str] = None\n    description: Optional[str] = None\n    status: Optional[CaseStatus] = None\n    urgency: Optional[int] = Field(default=None, ge=1, le=5)\n\n\nclass CaseResponse(BaseModel):\n    id: str\n    title: str\n    description: str\n    category: str\n    status: CaseStatus\n    urgency: int\n    user_id: str\n    created_at: datetime\n    updated_at: datetime\n\n\n# â”€â”€ Documents â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nclass DocumentResponse(BaseModel):\n    id: str\n    filename: str\n    status: DocumentStatus\n    chunk_count: int = 0\n    created_at: datetime\n\n\nclass DocumentListResponse(BaseModel):\n    documents: List[DocumentResponse]\n    total: int\n\n\n# â”€â”€ Health â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nclass HealthResponse(BaseModel):\n    status: str\n    version: str\n    environment: str\n',
