    'jroc-ai-pro-bono/supabase/functions/match_documents/index.ts': '// Supabase Edge Function: match_documents\n// Wraps the match_document_chunks RPC for direct client-side calls\n\nimport { serve } from "https://deno.land/std@0.168.0/http/server.ts";\nimport { createClient } from "https://esm.sh/@supabase/supabase-js@2";\nimport { corsHeaders } from "../_shared/cors.ts";\n\nserve(async (req: Request) => {\n  if (req.method === "OPTIONS") {\n    return new Response("ok", { headers: corsHeaders });\n  }\n\n  try {\n    const { query_embedding, match_threshold = 0.75, match_count = 8 } =\n      await req.json();\n\n    const supabase = createClient(\n      Deno.env.get("SUPABASE_URL") ?? "",\n      Deno.env.get("SUPABASE_SERVICE_ROLE_KEY") ?? "",\n      { auth: { persistSession: false } }\n    );\n\n    const { data, error } = await supabase.rpc("match_document_chunks", {\n      query_embedding,\n      match_threshold,\n      match_count,\n    });\n\n    if (error) throw error;\n\n    return new Response(JSON.stringify({ data }), {\n      headers: { ...corsHeaders, "Content-Type": "application/json" },\n      status: 200,\n    });\n  } catch (err) {\n    return new Response(JSON.stringify({ error: (err as Error).message }), {\n      headers: { ...corsHeaders, "Content-Type": "application/json" },\n      status: 500,\n    });\n  }\n});\n',
    'jroc-ai-pro-bono/supabase/migrations/20240001000001_rls_policies.sql': '-- ============================================================\n-- Migration 002: Row Level Security Policies\n-- JROC\'s AI Pro Bono Service\n-- ============================================================\n\n-- Enable RLS on all tables\nALTER TABLE public.profiles          ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.cases             ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.conversations     ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.messages          ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.documents         ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.document_chunks   ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.escalation_events ENABLE ROW LEVEL SECURITY;\n\n-- â”€â”€ profiles â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE POLICY "Users can view own profile"\n    ON public.profiles FOR SELECT\n    USING (auth.uid() = id);\n\nCREATE POLICY "Users can update own profile"\n    ON public.profiles FOR UPDATE\n    USING (auth.uid() = id)\n    WITH CHECK (auth.uid() = id);\n\n-- â”€â”€ cases â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE POLICY "Users can view own cases"\n    ON public.cases FOR SELECT\n    USING (auth.uid() = user_id);\n\nCREATE POLICY "Users can create own cases"\n    ON public.cases FOR INSERT\n    WITH CHECK (auth.uid() = user_id);\n\nCREATE POLICY "Users can update own cases"\n    ON public.cases FOR UPDATE\n    USING (auth.uid() = user_id)\n    WITH CHECK (auth.uid() = user_id);\n\nCREATE POLICY "Users can delete own cases"\n    ON public.cases FOR DELETE\n    USING (auth.uid() = user_id);\n\n-- â”€â”€ conversations â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE POLICY "Users can view own conversations"\n    ON public.conversations FOR SELECT\n    USING (auth.uid() = user_id);\n\nCREATE POLICY "Users can create own conversations"\n    ON public.conversations FOR INSERT\n    WITH CHECK (auth.uid() = user_id);\n\nCREATE POLICY "Users can update own conversations"\n    ON public.conversations FOR UPDATE\n    USING (auth.uid() = user_id);\n\nCREATE POLICY "Users can delete own conversations"\n    ON public.conversations FOR DELETE\n    USING (auth.uid() = user_id);\n\n-- â”€â”€ messages â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE POLICY "Users can view messages in own conversations"\n    ON public.messages FOR SELECT\n    USING (\n        EXISTS (\n            SELECT 1 FROM public.conversations c\n            WHERE c.id = messages.conversation_id\n            AND c.user_id = auth.uid()\n        )\n    );\n\nCREATE POLICY "Users can insert messages in own conversations"\n    ON public.messages FOR INSERT\n    WITH CHECK (\n        EXISTS (\n            SELECT 1 FROM public.conversations c\n            WHERE c.id = messages.conversation_id\n            AND c.user_id = auth.uid()\n        )\n    );\n\nCREATE POLICY "Users can delete messages in own conversations"\n    ON public.messages FOR DELETE\n    USING (\n        EXISTS (\n            SELECT 1 FROM public.conversations c\n            WHERE c.id = messages.conversation_id\n            AND c.user_id = auth.uid()\n        )\n    );\n\n-- â”€â”€ documents â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE POLICY "Users can view own documents"\n    ON public.documents FOR SELECT\n    USING (auth.uid() = user_id);\n\nCREATE POLICY "Users can create own documents"\n    ON public.documents FOR INSERT\n    WITH CHECK (auth.uid() = user_id);\n\nCREATE POLICY "Users can update own documents"\n    ON public.documents FOR UPDATE\n    USING (auth.uid() = user_id);\n\nCREATE POLICY "Users can delete own documents"\n    ON public.documents FOR DELETE\n    USING (auth.uid() = user_id);\n\n-- â”€â”€ document_chunks â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n-- Service role bypasses RLS for ingestion writes.\n-- Users can only query their own document chunks.\nCREATE POLICY "Users can view own document chunks"\n    ON public.document_chunks FOR SELECT\n    USING (auth.uid() = user_id);\n\nCREATE POLICY "Service role can manage document chunks"\n    ON public.document_chunks FOR ALL\n    USING (auth.role() = \'service_role\')\n    WITH CHECK (auth.role() = \'service_role\');\n\n-- â”€â”€ escalation_events â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE POLICY "Users can view own escalation events"\n    ON public.escalation_events FOR SELECT\n    USING (auth.uid() = user_id);\n\nCREATE POLICY "Service role can manage escalation events"\n    ON public.escalation_events FOR ALL\n    USING (auth.role() = \'service_role\')\n    WITH CHECK (auth.role() = \'service_role\');\n',
    'jroc-ai-pro-bono/supabase/migrations/20240001000002_rpc_functions.sql': "-- ============================================================\n-- Migration 003: RPC Functions for Vector Search\n-- JROC's AI Pro Bono Service\n-- ============================================================\n\n-- â”€â”€ match_document_chunks â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n-- Primary vector similarity search function called by the backend\n-- LegalResearchAgent via Supabase RPC.\n--\n-- Usage:\n--   SELECT * FROM match_document_chunks(\n--     query_embedding := '[0.1, 0.2, ...]'::vector,\n--     match_threshold := 0.75,\n--     match_count := 8\n--   );\n-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE OR REPLACE FUNCTION public.match_document_chunks(\n    query_embedding  VECTOR(1536),\n    match_threshold  FLOAT   DEFAULT 0.75,\n    match_count      INT     DEFAULT 8\n)\nRETURNS TABLE (\n    id              UUID,\n    document_id     UUID,\n    document_title  TEXT,\n    content         TEXT,\n    similarity      FLOAT\n)\nLANGUAGE sql\nSTABLE\nSECURITY DEFINER\nSET search_path = public\nAS $$\n    SELECT\n        dc.id,\n        dc.document_id,\n        d.filename  AS document_title,\n        dc.content,\n        1 - (dc.embedding <=> query_embedding) AS similarity\n    FROM public.document_chunks dc\n    JOIN public.documents d ON d.id = dc.document_id\n    WHERE 1 - (dc.embedding <=> query_embedding) >= match_threshold\n    ORDER BY dc.embedding <=> query_embedding   -- ascending distance = descending similarity\n    LIMIT match_count;\n$$;\n\n-- Grant execute to service role (backend) and authenticated users\nGRANT EXECUTE ON FUNCTION public.match_document_chunks TO service_role;\nGRANT EXECUTE ON FUNCTION public.match_document_chunks TO authenticated;\n\n\n-- â”€â”€ match_document_chunks_for_user â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n-- User-scoped variant â€” only returns chunks from the calling user's documents.\n-- Use this from the frontend with the anon key when RLS is active.\n-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE OR REPLACE FUNCTION public.match_document_chunks_for_user(\n    query_embedding  VECTOR(1536),\n    match_threshold  FLOAT   DEFAULT 0.75,\n    match_count      INT     DEFAULT 8,\n    p_user_id        UUID    DEFAULT auth.uid()\n)\nRETURNS TABLE (\n    id              UUID,\n    document_id     UUID,\n    document_title  TEXT,\n    content         TEXT,\n    similarity      FLOAT\n)\nLANGUAGE sql\nSTABLE\nSECURITY DEFINER\nSET search_path = public\nAS $$\n    SELECT\n        dc.id,\n        dc.document_id,\n        d.filename  AS document_title,\n        dc.content,\n        1 - (dc.embedding <=> query_embedding) AS similarity\n    FROM public.document_chunks dc\n    JOIN public.documents d ON d.id = dc.document_id\n    WHERE dc.user_id = p_user_id\n      AND 1 - (dc.embedding <=> query_embedding) >= match_threshold\n    ORDER BY dc.embedding <=> query_embedding\n    LIMIT match_count;\n$$;\n\nGRANT EXECUTE ON FUNCTION public.match_document_chunks_for_user TO authenticated;\nGRANT EXECUTE ON FUNCTION public.match_document_chunks_for_user TO service_role;\n\n\n-- â”€â”€ get_case_summary â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n-- Returns a case with its message count and last activity,\n-- used to build dashboard summaries quickly.\n-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE OR REPLACE FUNCTION public.get_case_summary(p_user_id UUID DEFAULT auth.uid())\nRETURNS TABLE (\n    case_id         UUID,\n    title           TEXT,\n    category        TEXT,\n    status          TEXT,\n    urgency         SMALLINT,\n    message_count   BIGINT,\n    last_activity   TIMESTAMPTZ,\n    created_at      TIMESTAMPTZ\n)\nLANGUAGE sql\nSTABLE\nSECURITY DEFINER\nSET search_path = public\nAS $$\n    SELECT\n        c.id            AS case_id,\n        c.title,\n        c.category,\n        c.status,\n        c.urgency,\n        COUNT(m.id)     AS message_count,\n        MAX(m.created_at) AS last_activity,\n        c.created_at\n    FROM public.cases c\n    LEFT JOIN public.conversations conv ON conv.case_id = c.id\n    LEFT JOIN public.messages m ON m.conversation_id = conv.id\n    WHERE c.user_id = p_user_id\n    GROUP BY c.id\n    ORDER BY c.updated_at DESC;\n$$;\n\nGRANT EXECUTE ON FUNCTION public.get_case_summary TO authenticated;\nGRANT EXECUTE ON FUNCTION public.get_case_summary TO service_role;\n\n\n-- â”€â”€ get_escalated_cases â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n-- Returns all unreviewed escalation events â€” used by the admin panel\n-- or attorney review workflow.\n-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE OR REPLACE FUNCTION public.get_escalated_cases()\nRETURNS TABLE (\n    escalation_id   UUID,\n    case_id         UUID,\n    case_title      TEXT,\n    user_id         UUID,\n    trigger_message TEXT,\n    escalated_at    TIMESTAMPTZ\n)\nLANGUAGE sql\nSTABLE\nSECURITY DEFINER\nSET search_path = public\nAS $$\n    SELECT\n        e.id            AS escalation_id,\n        e.case_id,\n        c.title         AS case_title,\n        e.user_id,\n        e.trigger_message,\n        e.created_at    AS escalated_at\n    FROM public.escalation_events e\n    LEFT JOIN public.cases c ON c.id = e.case_id\n    WHERE e.reviewed = false\n    ORDER BY e.created_at ASC;\n$$;\n\n-- Only service_role (backend admin operations) can call this\nGRANT EXECUTE ON FUNCTION public.get_escalated_cases TO service_role;\n\n\n-- â”€â”€ delete_user_data â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n-- GDPR helper: cascade-deletes all data for a user.\n-- Called by the backend admin API only â€” NOT exposed to clients.\n-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE OR REPLACE FUNCTION public.delete_user_data(p_user_id UUID)\nRETURNS void\nLANGUAGE plpgsql\nSECURITY DEFINER\nSET search_path = public\nAS $$\nBEGIN\n    DELETE FROM public.document_chunks   WHERE user_id = p_user_id;\n    DELETE FROM public.documents         WHERE user_id = p_user_id;\n    DELETE FROM public.messages\n        WHERE conversation_id IN (\n            SELECT id FROM public.conversations WHERE user_id = p_user_id\n        );\n    DELETE FROM public.conversations     WHERE user_id = p_user_id;\n    DELETE FROM public.cases             WHERE user_id = p_user_id;\n    DELETE FROM public.escalation_events WHERE user_id = p_user_id;\n    DELETE FROM public.profiles          WHERE id       = p_user_id;\nEND;\n$$;\n\nGRANT EXECUTE ON FUNCTION public.delete_user_data TO service_role;\n",
    'jroc-ai-pro-bono/supabase/migrations/20240001000000_init_schema.sql': '-- ============================================================\n-- Migration 001: Initial schema\n-- JROC\'s AI Pro Bono Service\n-- ============================================================\n\n-- Enable required extensions\nCREATE EXTENSION IF NOT EXISTS "uuid-ossp";\nCREATE EXTENSION IF NOT EXISTS "vector";\nCREATE EXTENSION IF NOT EXISTS "pg_trgm";  -- for text search\n\n-- â”€â”€ Users (mirrors Supabase Auth) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\n-- auth.users is managed by Supabase Auth; we extend it via a profile table.\nCREATE TABLE IF NOT EXISTS public.profiles (\n    id          UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,\n    email       TEXT,\n    full_name   TEXT,\n    created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),\n    updated_at  TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\n-- â”€â”€ Cases â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE TABLE IF NOT EXISTS public.cases (\n    id          UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    user_id     UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,\n    title       TEXT NOT NULL CHECK (char_length(title) <= 200),\n    description TEXT NOT NULL,\n    category    TEXT NOT NULL,\n    status      TEXT NOT NULL DEFAULT \'open\'\n                    CHECK (status IN (\'open\',\'in_progress\',\'escalated\',\'closed\')),\n    urgency     SMALLINT NOT NULL DEFAULT 3\n                    CHECK (urgency BETWEEN 1 AND 5),\n    created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),\n    updated_at  TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nCREATE INDEX idx_cases_user_id   ON public.cases(user_id);\nCREATE INDEX idx_cases_status    ON public.cases(status);\nCREATE INDEX idx_cases_created   ON public.cases(created_at DESC);\n\n-- â”€â”€ Conversations â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE TABLE IF NOT EXISTS public.conversations (\n    id          UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    user_id     UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,\n    case_id     UUID REFERENCES public.cases(id) ON DELETE SET NULL,\n    created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),\n    updated_at  TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nCREATE INDEX idx_conversations_user_id ON public.conversations(user_id);\nCREATE INDEX idx_conversations_case_id ON public.conversations(case_id);\n\n-- â”€â”€ Messages â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE TABLE IF NOT EXISTS public.messages (\n    id              UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    conversation_id UUID NOT NULL REFERENCES public.conversations(id) ON DELETE CASCADE,\n    role            TEXT NOT NULL CHECK (role IN (\'user\',\'assistant\',\'system\')),\n    content         TEXT NOT NULL,\n    metadata        JSONB DEFAULT \'{}\',\n    created_at      TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nCREATE INDEX idx_messages_conversation_id ON public.messages(conversation_id);\nCREATE INDEX idx_messages_created         ON public.messages(created_at ASC);\n\n-- â”€â”€ Documents â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE TABLE IF NOT EXISTS public.documents (\n    id          UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    user_id     UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,\n    filename    TEXT NOT NULL,\n    file_path   TEXT,\n    file_type   TEXT,\n    status      TEXT NOT NULL DEFAULT \'pending\'\n                    CHECK (status IN (\'pending\',\'processing\',\'ready\',\'failed\')),\n    chunk_count INT NOT NULL DEFAULT 0,\n    created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),\n    updated_at  TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nCREATE INDEX idx_documents_user_id ON public.documents(user_id);\nCREATE INDEX idx_documents_status  ON public.documents(status);\n\n-- â”€â”€ Document Chunks (pgvector) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE TABLE IF NOT EXISTS public.document_chunks (\n    id              UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    document_id     UUID NOT NULL REFERENCES public.documents(id) ON DELETE CASCADE,\n    user_id         UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,\n    content         TEXT NOT NULL,\n    embedding       VECTOR(1536),   -- text-embedding-3-small dimension\n    chunk_index     INT NOT NULL DEFAULT 0,\n    created_at      TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nCREATE INDEX idx_chunks_document_id ON public.document_chunks(document_id);\nCREATE INDEX idx_chunks_user_id     ON public.document_chunks(user_id);\n-- IVFFlat index for approximate nearest-neighbor search (tune lists based on row count)\nCREATE INDEX idx_chunks_embedding   ON public.document_chunks\n    USING ivfflat (embedding vector_cosine_ops)\n    WITH (lists = 100);\n\n-- â”€â”€ Escalation Events â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE TABLE IF NOT EXISTS public.escalation_events (\n    id              UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n    user_id         UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,\n    case_id         UUID REFERENCES public.cases(id) ON DELETE SET NULL,\n    trigger_message TEXT,\n    reviewed        BOOLEAN NOT NULL DEFAULT false,\n    reviewed_by     UUID REFERENCES auth.users(id) ON DELETE SET NULL,\n    reviewed_at     TIMESTAMPTZ,\n    created_at      TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nCREATE INDEX idx_escalations_user_id   ON public.escalation_events(user_id);\nCREATE INDEX idx_escalations_reviewed  ON public.escalation_events(reviewed);\n\n-- â”€â”€ Updated-at triggers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE OR REPLACE FUNCTION public.set_updated_at()\nRETURNS TRIGGER AS $$\nBEGIN\n    NEW.updated_at = now();\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER trg_cases_updated_at\n    BEFORE UPDATE ON public.cases\n    FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();\n\nCREATE TRIGGER trg_conversations_updated_at\n    BEFORE UPDATE ON public.conversations\n    FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();\n\nCREATE TRIGGER trg_documents_updated_at\n    BEFORE UPDATE ON public.documents\n    FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();\n\n-- â”€â”€ Auto-create profile on signup â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€\nCREATE OR REPLACE FUNCTION public.handle_new_user()\nRETURNS TRIGGER AS $$\nBEGIN\n    INSERT INTO public.profiles (id, email)\n    VALUES (NEW.id, NEW.email)\n    ON CONFLICT (id) DO NOTHING;\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql SECURITY DEFINER;\n\nCREATE OR REPLACE TRIGGER on_auth_user_created\n    AFTER INSERT ON auth.users\n    FOR EACH ROW EXECUTE FUNCTION public.handle_new_user();\n',
    'jroc-ai-pro-bono/supabase/migrations/20240001000003_seed_data.sql': "-- ============================================================\n-- Migration 004: Optional Seed Data (Dev / Demo Only)\n-- Run ONLY in development â€” do NOT apply to production\n-- ============================================================\n\n-- Sample legal document categories for reference\nINSERT INTO public.documents (id, user_id, filename, file_type, status, chunk_count)\nVALUES\n    ('00000000-0000-0000-0000-000000000001',\n     '00000000-0000-0000-0000-000000000000',\n     'PA Tenant Rights Guide 2024.pdf', 'pdf', 'ready', 42),\n    ('00000000-0000-0000-0000-000000000002',\n     '00000000-0000-0000-0000-000000000000',\n     'FLSA Wage Theft Overview.pdf', 'pdf', 'ready', 28),\n    ('00000000-0000-0000-0000-000000000003',\n     '00000000-0000-0000-0000-000000000000',\n     'Philadelphia Fair Housing Ordinance.pdf', 'pdf', 'ready', 35)\nON CONFLICT (id) DO NOTHING;\n",
