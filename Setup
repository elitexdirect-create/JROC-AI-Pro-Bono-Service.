# â”€â”€ GitHub Project Board â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
hdr "Creating GitHub Project Board"

# Create project via GraphQL (Projects v2)
PROJECT_RESP=$(gh api graphql -f query='
  mutation {
    createProjectV2(input: {
      ownerId: "'$(gh api "users/$OWNER" --jq '.node_id')'"
      title: "JROC AI Pro Bono â€” Roadmap"
      repositoryId: "'$(gh api "repos/$FULL_REPO" --jq '.node_id')'"
    }) {
      projectV2 {
        id
        url
        number
      }
    }
  }
')

PROJECT_URL=$(echo "$PROJECT_RESP" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['data']['createProjectV2']['projectV2']['url'])" 2>/dev/null || echo "(check GitHub manually)")

ok "Project board created: $PROJECT_URL"

# â”€â”€ Summary â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
hdr "Setup Complete"

echo ""
echo -e "  ${BOLD}Repository${R}   : https://github.com/$FULL_REPO"
echo -e "  ${BOLD}Milestones${R}   : https://github.com/$FULL_REPO/milestones"
echo -e "  ${BOLD}Labels${R}       : https://github.com/$FULL_REPO/labels"
echo -e "  ${BOLD}Issues${R}       : https://github.com/$FULL_REPO/issues"
echo -e "  ${BOLD}Project Board${R}: $PROJECT_URL"
echo ""
echo -e "${GRN}${BOLD}All done! JROC GitHub project is ready. âš–ï¸ ðŸ¤–${R}"
echo ""
