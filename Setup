# â”€â”€ Issues â€” v1.1.0 â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
hdr "Creating issues â€” v1.1.0 Polish"

# Get milestone numbers
M11=$(gh api "repos/$FULL_REPO/milestones" --jq '.[] | select(.title | startswith("v1.1")) | .number')
M12=$(gh api "repos/$FULL_REPO/milestones" --jq '.[] | select(.title | startswith("v1.2")) | .number')
M13=$(gh api "repos/$FULL_REPO/milestones" --jq '.[] | select(.title | startswith("v1.3")) | .number')
M20=$(gh api "repos/$FULL_REPO/milestones" --jq '.[] | select(.title | startswith("v2.0")) | .number')
M21=$(gh api "repos/$FULL_REPO/milestones" --jq '.[] | select(.title | startswith("v2.1")) | .number')
M23=$(gh api "repos/$FULL_REPO/milestones" --jq '.[] | select(.title | startswith("v2.3")) | .number')
M30=$(gh api "repos/$FULL_REPO/milestones" --jq '.[] | select(.title | startswith("v3.0")) | .number')
M32=$(gh api "repos/$FULL_REPO/milestones" --jq '.[] | select(.title | startswith("v3.2")) | .number')

create_issue() {
  local title="$1" body="$2" labels="$3" milestone="$4"
  gh issue create \
    --repo "$FULL_REPO" \
    --title "$title" \
    --body "$body" \
    --label "$labels" \
    --milestone "$milestone" \
    && ok "Issue: $title" || wrn "Failed to create issue: $title"
}

create_issue \
  "feat: Add SSE streaming chat responses" \
  "## Overview\nImplement Server-Sent Events (SSE) endpoint for token-by-token streaming chat.\n\n## Tasks\n- [ ] Add \`/chat/stream\` SSE endpoint in FastAPI\n- [ ] Update SupervisorAgent to yield tokens\n- [ ] Frontend SSE consumer in \`use-chat\` hook\n- [ ] Display tokens as they arrive in ChatMessage component\n- [ ] Handle stream errors + reconnect\n\n## Acceptance Criteria\n- User sees words appear as AI types them\n- Stream closes cleanly on completion or error\n- Works on mobile browsers" \
  "v1.1,backend,frontend,agent,priority: high" "$M11"

