#  JROC's AI Pro Bono Service â€” GitHub Project Board Setup
#  Creates milestones, labels, and issues using the GitHub CLI (gh)
#
#  REQUIREMENTS: gh CLI authenticated  â†’  gh auth login
#  USAGE:
#    bash scripts/setup_github_project.sh realjayroc215 jroc-ai-pro-bono
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
set -euo pipefail

OWNER="${1:-realjayroc215}"
REPO="${2:-jroc-ai-pro-bono}"
FULL_REPO="$OWNER/$REPO"

GRN="\033[0;32m"; BLU="\033[0;34m"; YLW="\033[0;33m"; RED="\033[0;31m"
BOLD="\033[1m"; R="\033[0m"
ok()  { echo -e "${GRN}âœ”${R}  $*"; }
hdr() { echo -e "\n${BOLD}${BLU}â•â• $* â•â•${R}"; }
wrn() { echo -e "${YLW}âš ${R}  $*"; }
err() { echo -e "${RED}âœ˜${R}  $*" >&2; }

# â”€â”€ Preflight â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
hdr "Preflight checks"
if ! command -v gh &>/dev/null; then
  err "GitHub CLI (gh) not found. Install: https://cli.github.com"
  exit 1
fi
if ! gh auth status &>/dev/null; then
  err "Not authenticated. Run: gh auth login"
  exit 1
fi
ok "gh CLI authenticated"
echo "  Targeting: github.com/$FULL_REPO"

# â”€â”€ Milestones â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
hdr "Creating milestones"

create_milestone() {
  local title="$1" due="$2" desc="$3"
  gh api "repos/$FULL_REPO/milestones" \
    --method POST \
    --field title="$title" \
    --field due_on="${due}T07:00:00Z" \
    --field description="$desc" \
    --silent && ok "Milestone: $title" || wrn "Milestone may already exist: $title"
}

create_milestone "v1.1.0 - Polish"          "2024-09-30" "UX refinements, streaming chat, mobile polish, rate limiting"
create_milestone "v1.2.0 - Intelligence"    "2024-10-31" "Smarter agents, hybrid search, jurisdiction awareness, LangGraph"
create_milestone "v1.3.0 - Community"       "2024-11-30" "Resource directory, SMS alerts, feedback system, accessibility"
create_milestone "v2.0.0 - Attorney Portal" "2025-01-31" "Human-in-the-loop, case assignment, admin panel, secure messaging"
create_milestone "v2.1.0 - Mobile App"      "2025-03-31" "React Native iOS + Android app, push notifications, camera upload"
create_milestone "v2.2.0 - Live Support"    "2025-05-31" "Real-time messaging, video calls, volunteer network"
create_milestone "v2.3.0 - Analytics"       "2025-07-31" "Impact dashboard, grant exports, A/B testing framework"
create_milestone "v3.0.0 - Platform"        "2026-01-31" "Multi-tenant SaaS, white-label, Kubernetes, SOC 2"
create_milestone "v3.1.0 - Marketplace"     "2026-03-31" "Attorney marketplace, booking, escrow payments, reviews"
create_milestone "v3.2.0 - Voice + SMS"     "2026-06-30" "Twilio IVR, SMS sessions, PWA offline, email interface"

# â”€â”€ Labels â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
hdr "Creating labels"

create_label() {
  local name="$1" color="$2" desc="$3"
  gh api "repos/$FULL_REPO/labels" \
    --method POST \
    --field name="$name" \
    --field color="$color" \
    --field description="$desc" \
    --silent && ok "Label: $name" || wrn "Label may already exist: $name"
}

